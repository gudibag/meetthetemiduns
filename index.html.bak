<!-- ── RSVP BADGE ─────────────────────────────────────────────────────────── -->
<div class="rsvp-badge" id="rsvpBadge" onclick="alert('RSVP Admin\n\n' + getRSVPSummary())"></div>

<!-- ── MODALS ──────────────────────────────────────────────────────────────── -->
<!-- Thank You Modal -->
<div class="modal-overlay" id="thankYouModal">
  <div class="modal">
    <button class="modal-close" onclick="closeModal('thankYouModal')">✕</button>
    <div class="modal-icon">🎉</div>
    <div class="modal-title">You're on the list!</div>
    <p class="modal-text">Thank you for confirming your attendance. We can't wait to celebrate with you!</p>
    <div class="modal-hash">#MeetTheTemiduns</div>
    <div class="hearts"><span class="heart">💛</span><span class="heart">💚</span><span class="heart">🧡</span></div>
  </div>
</div>

<!-- Lightbox Modal -->
<div class="modal-overlay" id="lightboxModal">
  <div class="modal">
    <button class="modal-close" onclick="closeModal('lightboxModal')">✕</button>
    <div class="modal-icon">📷</div>
    <div class="modal-title">Photo Coming Soon</div>
    <p class="modal-text">We're still collecting our favourite memories. Check back closer to the wedding for our full gallery!</p>
  </div>
</div>

<!-- Pledge Modal -->
<div class="modal-overlay" id="pledgeModal">
  <div class="modal reg-modal">
    <button class="modal-close" onclick="closeModal('pledgeModal')">✕</button>
    <div class="modal-icon" id="plEmoji">🎁</div>
    <div class="modal-title" id="plName">Item</div>
    <p class="reg-remaining" id="plRemaining"></p>

    <div class="reg-field">
      <label>Your Name</label>
      <input type="text" id="plGiver" placeholder="So we can thank you personally">
    </div>
    <div class="reg-field">
      <label>Amount to give (₦)</label>
      <input type="number" id="plAmount" placeholder="e.g. 20000" min="500">
    </div>

    <div class="reg-acctbox">
      <div>🏦 <strong>FIRST BANK</strong></div>
      <div>TEMITOPE AWOSIKU</div>
      <div class="reg-acctno"><span id="plAcct">3157355320</span>
        <button onclick="regCopyAcct('naira', this)">Copy</button></div>
      <div class="reg-ref">Reference: <strong>#MeetTheTemiduns</strong></div>
    </div>
    <p class="reg-steps">1. Transfer to the account above &nbsp;→&nbsp; 2. Tap the button so we can match your gift</p>

    <button class="btn-rsvp" id="plConfirm" onclick="submitPledge()">💛 I've made my transfer</button>
    <p class="reg-privacy">🔒 Your gift is private — the item only updates once we’ve confirmed your transfer — so nothing here can be faked.</p>
  </div>
</div>

<script>
// ── COUNTDOWN ────────────────────────────────────────────────────────────────
(function countdown() {
  const target = new Date('2026-11-20T10:00:00');
  function tick() {
    const now = new Date();
    const diff = target - now;
    if (diff <= 0) { document.getElementById('countdown').innerHTML = '<div class="countdown-unit"><span class="countdown-num">🎊</span><span class="countdown-label">We\'re Married!</span></div>'; return; }
    const d = Math.floor(diff/864e5);
    const h = Math.floor((diff%864e5)/36e5);
    const m = Math.floor((diff%36e5)/6e4);
    const s = Math.floor((diff%6e4)/1e3);
    document.getElementById('cd-days').textContent = String(d).padStart(2,'0');
    document.getElementById('cd-hrs').textContent  = String(h).padStart(2,'0');
    document.getElementById('cd-min').textContent  = String(m).padStart(2,'0');
    document.getElementById('cd-sec').textContent  = String(s).padStart(2,'0');
  }
  tick(); setInterval(tick,1000);
})();

// ── NAV ──────────────────────────────────────────────────────────────────────
window.addEventListener('scroll', () => {
  document.getElementById('navbar').classList.toggle('scrolled', window.scrollY > 50);
});
const ham = document.getElementById('hamburger');
const menu = document.getElementById('mobileMenu');
ham.addEventListener('click', () => {
  ham.classList.toggle('open');
  menu.classList.toggle('open');
});
document.querySelectorAll('.mobile-link').forEach(a => {
  a.addEventListener('click', () => { ham.classList.remove('open'); menu.classList.remove('open'); });
});

// ── SCROLL REVEAL ─────────────────────────────────────────────────────────────
const observer = new IntersectionObserver(entries => {
  entries.forEach((e,i) => {
    if(e.isIntersecting) {
      setTimeout(() => e.target.classList.add('visible'), i*120);
      observer.unobserve(e.target);
    }
  });
}, { threshold:0.12 });
document.querySelectorAll('.reveal, .timeline-card, .event-card, .gift-card, .travel-card, .faq-item').forEach(el => observer.observe(el));

// ── FAQ ACCORDION ─────────────────────────────────────────────────────────────
document.querySelectorAll('.faq-q').forEach(q => {
  q.addEventListener('click', () => {
    const item = q.parentElement;
    const wasOpen = item.classList.contains('open');
    document.querySelectorAll('.faq-item').forEach(i => i.classList.remove('open'));
    if(!wasOpen) item.classList.add('open');
  });
});

// ── RSVP ─────────────────────────────────────────────────────────────────────
const SHEET_URL = 'https://script.google.com/macros/s/AKfycbx8mtEDrT_TA6x4Zi4E-HWJ6ZSm8ksdcGXmT9S-JqarL6bj05Bgxhhz1qBnWHkyGScB/exec';

document.getElementById('rsvpForm')?.addEventListener('submit', async function(e) {
  e.preventDefault();

  // Validation
  let valid = true;
  const firstname  = document.getElementById('rsvp-firstname');
  const lastname   = document.getElementById('rsvp-lastname');
  const email      = document.getElementById('rsvp-email');
  const fg_firstname  = document.getElementById('fg-firstname');
  const fg_lastname   = document.getElementById('fg-lastname');
  const fg_email      = document.getElementById('fg-email');

  fg_firstname.classList.toggle('has-error', !firstname.value.trim());
  if (!firstname.value.trim()) valid = false;
  fg_lastname.classList.toggle('has-error', !lastname.value.trim());
  if (!lastname.value.trim()) valid = false;
  const emailVal = email.value.trim();
  if (emailVal) {
    const emailValid = /\S+@\S+\.\S+/.test(emailVal);
    fg_email.classList.toggle('has-error', !emailValid);
    if (!emailValid) valid = false;
  } else {
    fg_email.classList.remove('has-error');
  }
  if (!valid) return;

  // Check localStorage — prevent double submission on same device
  if (localStorage.getItem('temidunUserRSVPed')) {
    document.getElementById('rsvpWrapper').innerHTML =
      `<div class="rsvp-already">You've already RSVPed! 🎉<br>
       <span style="font-size:1rem;color:var(--gold);font-style:italic">#MeetTheTemiduns</span></div>`;
    return;
  }

  // Show loading state
  const btn = document.querySelector('.btn-rsvp');
  btn.textContent = 'Sending...';
  btn.disabled = true;

  try {
    const payload = {
      firstname: firstname.value.trim(),
      lastname: lastname.value.trim(),
      email: email.value.trim().toLowerCase(),
      phone: document.getElementById('rsvp-phone').value.trim(),
      message: document.getElementById('rsvp-msg').value.trim()
    };

    const res = await fetch(SHEET_URL, {
      method: 'POST',
      body: JSON.stringify(payload)
    });
    const result = await res.json();

    if (result.status === 'duplicate') {
      // Already in the Sheet — still mark locally and show thank you
      localStorage.setItem('temidunUserRSVPed', 'true');
      openModal('thankYouModal');
      document.getElementById('rsvpWrapper').innerHTML =
        `<div class="rsvp-already">You've already RSVPed! 🎉<br>
         <span style="font-size:1rem;color:var(--gold);font-style:italic">#MeetTheTemiduns</span></div>`;

    } else if (result.status === 'success') {
      localStorage.setItem('temidunUserRSVPed', 'true');
      openModal('thankYouModal');
      document.getElementById('rsvpWrapper').innerHTML =
        `<div class="rsvp-already">You've already RSVPed! 🎉<br>
         <span style="font-size:1rem;color:var(--gold);font-style:italic">#MeetTheTemiduns</span></div>`;

    } else {
      throw new Error('Unexpected response');
    }

  } catch (err) {
    btn.textContent = 'Confirm My Attendance ✨';
    btn.disabled = false;
    alert('Something went wrong. Please try again or contact us directly.');
  }
});

// ── MODALS ────────────────────────────────────────────────────────────────────
function openModal(id) { document.getElementById(id).classList.add('open'); }
function closeModal(id) { document.getElementById(id).classList.remove('open'); }
document.querySelectorAll('.modal-overlay').forEach(o => {
  o.addEventListener('click', e => { if(e.target===o) o.classList.remove('open'); });
});

const ACCOUNT_DETAILS = {
  naira: {
    full: 'Account name: TEMITOPE AWOSIKU\nAccount number: 3157355320\nBank name: FIRST BANK\n\nAccount name: Goodness D. Folayan\nAccount number: 3087842349\nBank name: First bank Nig',
    name: 'TEMITOPE AWOSIKU',
    number: '3157355320',
    bank: 'FIRST BANK',
    altName: 'Goodness D. Folayan',
    altNumber: '3087842349',
    altBank: 'FIRST BANK'
  },
  dollar: {
    full: 'Account name: GOODNESS DUNSIN FOLAYAN\nAccount Number: 218095108511\nACH Routing Number: 101019644\nBank Name: LEAD BANK',
    name: 'GOODNESS DUNSIN FOLAYAN',
    number: '218095108511',
    routing: '101019644',
    bank: 'LEAD BANK'
  }
};
function regCopyAcct(type = 'naira', btn) {
  const text = ACCOUNT_DETAILS[type]?.full || ACCOUNT_DETAILS.naira.full;
  copyText(text, btn);
}
function copyDetail(type = 'naira', field = 'name', btn) {
  const text = ACCOUNT_DETAILS[type]?.[field] || '';
  copyText(text, btn);
}
function copyText(text, btn) {
  navigator.clipboard.writeText(text).then(() => {
    if (btn) {
      const original = btn.innerHTML;
      btn.innerHTML = '✓';
      btn.classList.add('copied');
      setTimeout(() => {
        btn.innerHTML = original;
        btn.classList.remove('copied');
      }, 1600);
    }
  }).catch(() => { alert(text); });
}

/* ===== REGISTRY LOGIC — pasted from MeetTheTemiduns.html ===== */
const REGISTRY_URL = 'https://script.google.com/macros/s/AKfycbzj7OUPTaN22W1rQ2jHbRhY0KACBoO-RDA9rU0b57el-5kX08yiKxX4DlRy_3BgeR9ONQ/exec';
const NAIRA = n => '₦' + Number(n||0).toLocaleString();
const kFmt  = n => n>=1000 ? '₦'+Math.round(n/1000)+'k' : NAIRA(n);
let REG_STATE = { items: [] };

async function loadRegistry() {
  const grid = document.getElementById('regGrid');
  if (!grid) return;
  try {
    const res = await fetch(REGISTRY_URL + '?action=registry');
    const data = await res.json();
    if (data.status !== 'success') throw new Error('bad response');
    REG_STATE = data;
    renderSummary(data.summary);
    renderGrid(data.items);
  } catch (err) {
    grid.innerHTML = '<div class="reg-loading">Registry is warming up — please refresh in a moment. 💛</div>';
  }
}

function renderSummary(s) {
  document.getElementById('sumCount').textContent   = s.count;
  document.getElementById('sumPledged').textContent = kFmt(s.totalPledged);
  document.getElementById('sumBlessed').textContent = s.blessed;
}

function renderGrid(items) {
  const grid = document.getElementById('regGrid');
  if (!items.length) { grid.innerHTML = '<div class="reg-loading">Registry coming soon 💛</div>'; return; }
  grid.innerHTML = items.map((it, i) => {
    const pct  = it.goal ? Math.min(100, Math.round(it.pledged/it.goal*100)) : 0;
    const done = it.goal && it.pledged >= it.goal;
    return `
      <div class="reg-card ${done?'done':''}">
        <div class="reg-thumb">${it.emoji}${it.category?`<span class="reg-tag">${it.category}</span>`:''}</div>
        <div class="reg-body">
          <div class="reg-name">${it.item}</div>
          <p class="reg-desc">${it.description||''}</p>
          <div class="reg-price"><span class="goal">Goal</span><span class="amt">${NAIRA(it.goal)}</span></div>
          <div class="reg-bar"><div class="reg-fill" style="width:${pct}%"></div></div>
          <div class="reg-prog"><span><b>${NAIRA(it.pledged)}</b> pledged</span><span>${pct}%</span></div>
          ${done
            ? `<button class="reg-btn done">✓ Fully Blessed</button>`
            : `<button class="reg-btn" onclick="openPledge(${i})">💛 Contribute</button>`}
        </div>
      </div>`;
  }).join('');
}

let CURRENT_ITEM = null;
function openPledge(i) {
  const it = REG_STATE.items[i];
  CURRENT_ITEM = it;
  const remaining = Math.max(0, it.goal - it.pledged);
  document.getElementById('plEmoji').textContent = it.emoji;
  document.getElementById('plName').textContent  = it.item;
  document.getElementById('plRemaining').textContent =
    remaining>0 ? `${NAIRA(remaining)} still needed toward ${NAIRA(it.goal)}` : 'Any amount is a blessing!';
  document.getElementById('plGiver').value  = '';
  document.getElementById('plAmount').value = remaining || '';
  document.getElementById('plConfirm').textContent = "💛 I've made my transfer";
  document.getElementById('plConfirm').disabled = false;
  openModal('pledgeModal');
}

async function submitPledge() {
  const giver  = document.getElementById('plGiver').value.trim();
  const amount = Number(document.getElementById('plAmount').value);
  const btn    = document.getElementById('plConfirm');
  if (!amount || amount < 500) { alert('Please enter an amount (min ₦500).'); return; }
  btn.textContent = 'Recording…'; btn.disabled = true;
  try {
    const res = await fetch(REGISTRY_URL, {
      method: 'POST',
      body: JSON.stringify({
        type: 'pledge',
        item: CURRENT_ITEM.item,
        name: giver || 'Anonymous',
        amount: amount,
        ref: '#MeetTheTemiduns'
      })
    });
    const data = await res.json();
    if (data.status === 'success') {
      closeModal('pledgeModal');
      showPledgeThanks();
    } else throw new Error();
  } catch (err) {
    btn.textContent = "💛 I've made my transfer"; btn.disabled = false;
    alert('Could not record that — please try again or message us directly.');
  }
}

function showPledgeThanks() {
  const m = document.getElementById('thankYouModal');
  const title = m.querySelector('.modal-title');
  const text  = m.querySelector('.modal-text');
  if (title) title.textContent = 'Thank you — gift noted!';
  if (text) text.innerHTML = "Please complete your transfer if you haven't yet. "
    + 'Once we confirm it in our records, your gift will count toward the item.'
    + '<br><br>Your details stay private. 💛';
  openModal('thankYouModal');
}

document.addEventListener('DOMContentLoaded', () => {
  if (document.getElementById('regGrid')) loadRegistry();
});

// ── LIGHTBOX ───────────────────────────────────────────────────────────────────
const galleryImages = [
  'images/20260529_132151.jpg',
  'images/IMG_5515.JPG',
  'images/IMG_5519.JPG',
  'images/IMG_5566.JPG',
  'images/IMG_5570.JPG'
];

function openLightbox(i) {
  const modal = document.getElementById('lightboxModal');
  const icon = modal.querySelector('.modal-icon');
  const title = modal.querySelector('.modal-title');
  const text = modal.querySelector('.modal-text');
  const src = galleryImages[i] || galleryImages[0];

  // Show full image sized to viewport while preserving aspect ratio
  icon.innerHTML = `<img src="${src}" alt="Gallery photo ${i + 1}" style="max-width:90vw;max-height:90vh;width:auto;height:auto;object-fit:contain;display:block;margin:0 auto;border-radius:8px;">`;
  title.textContent = `Photo ${i + 1}`;
  text.textContent = 'Tap outside or press × to close.';
  openModal('lightboxModal');
}

// ── GALLERY SLIDESHOW ──────────────────────────────────────────────────────
let gallerySlides = [];
let galleryDots = null;
let currentGalleryIndex = 0;

function setGallerySlide(index) {
  gallerySlides.forEach((slide, i) => {
    slide.classList.toggle('active', i === index);
  });
  if (galleryDots) {
    Array.from(galleryDots.children).forEach((dot, i) => {
      dot.classList.toggle('active', i === index);
    });
  }
  currentGalleryIndex = index;
}

function createGalleryDots() {
  if (!galleryDots) return;
  galleryImages.forEach((_, i) => {
    const dot = document.createElement('button');
    dot.type = 'button';
    dot.className = 'gallery-dot' + (i === 0 ? ' active' : '');
    dot.addEventListener('click', () => setGallerySlide(i));
    galleryDots.appendChild(dot);
  });
}

function renderGallerySlides() {
  const container = document.getElementById('gallerySlider');
  if (!container) return;
  container.innerHTML = '';

  galleryImages.forEach((src, index) => {
    const slide = document.createElement('button');
    slide.type = 'button';
    slide.className = 'gallery-slide' + (index === 0 ? ' active' : '');
    slide.style.backgroundImage = `url('${src}')`;
    slide.setAttribute('aria-label', `Open photo ${index + 1}`);
    slide.setAttribute('tabindex', '0');
    slide.addEventListener('click', () => openLightbox(index));
    slide.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        openLightbox(index);
      }
    });
    container.appendChild(slide);
  });

  const dotWrapper = document.createElement('div');
  dotWrapper.id = 'galleryDots';
  dotWrapper.className = 'gallery-dots';
  container.appendChild(dotWrapper);
}

function startGallerySlideshow() {
  renderGallerySlides();
  gallerySlides = Array.from(document.querySelectorAll('.gallery-slide'));
  galleryDots = document.getElementById('galleryDots');
  const container = document.getElementById('gallerySlider');
  if (!gallerySlides.length || !galleryDots || !container) return;
  createGalleryDots();

  setGallerySlide(0);

  // Autoplay timer (can be paused on hover)
  let slideshowTimer = null;
  const advance = () => {
    const nextIndex = (currentGalleryIndex + 1) % gallerySlides.length;
    setGallerySlide(nextIndex);
  };
  const startTimer = () => { if (!slideshowTimer) slideshowTimer = setInterval(advance, 4500); };
  const stopTimer  = () => { if (slideshowTimer) { clearInterval(slideshowTimer); slideshowTimer = null; } };

  // Start autoplay
  startTimer();

  // Pause on hover / resume on leave
  container.addEventListener('mouseenter', stopTimer);
  container.addEventListener('mouseleave', startTimer);
}

if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', startGallerySlideshow);
} else {
  startGallerySlideshow();
}

// ── ADD TO CALENDAR ────────────────────────────────────────────────────────────
function downloadICS(title, startUTC, endUTC, location, description) {
  const ics = `BEGIN:VCALENDAR\r\nVERSION:2.0\r\nPRODID:-//MeetTheTemiduns//EN\r\nBEGIN:VEVENT\r\nDTSTART:${startUTC}\r\nDTEND:${endUTC}\r\nSUMMARY:${title}\r\nDESCRIPTION:${description}\r\nLOCATION:${location}\r\nEND:VEVENT\r\nEND:VCALENDAR`;
  const blob = new Blob([ics],{type:'text/calendar'});
  const a = Object.assign(document.createElement('a'),{href:URL.createObjectURL(blob),download:`MeetTheTemiduns_${title.replace(/[^\w]+/g,'_')}.ics`});
  a.click();
}

function addToGoogleCalendar(title, startUTC, endUTC, description, location) {
  const url = 'https://calendar.google.com/calendar/render?action=TEMPLATE'
    + '&text=' + encodeURIComponent(title)
    + '&dates=' + startUTC + '/' + endUTC
    + '&details=' + encodeURIComponent(description)
    + '&location=' + encodeURIComponent(location);
  window.open(url, '_blank', 'noopener');
}
</script>
</body>
</html>
