<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>#MeetTheTemiduns — Temitope & Dunsin </title>
<meta name="description" content="Temitope & Dunsin are getting married on November 20, 2026 in Ondo Town, Nigeria. RSVP, gift registry, and all the details.">

<!-- Open Graph / social preview -->
<meta property="og:type" content="website">
<meta property="og:title" content="#MeetTheTemiduns — Temitope & Dunsin">
<meta property="og:description" content="We're getting married! November 20, 2026 · Ondo Town, Nigeria. RSVP and join our celebration.">
<meta property="og:image" content="https://gudibag.github.io/meetthetemiduns/images/IMG_5515.JPG">
<meta property="og:url" content="https://gudibag.github.io/meetthetemiduns/">
<meta property="og:site_name" content="#MeetTheTemiduns">

<!-- Twitter card -->
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="#MeetTheTemiduns — Temitope & Dunsin">
<meta name="twitter:description" content="We're getting married! November 20, 2026 · Ondo Town, Nigeria. RSVP and join our celebration.">
<meta name="twitter:image" content="https://gudibag.github.io/meetthetemiduns/images/IMG_5515.JPG">

<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Jost:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
:root {
  --teal:    #B8767F;
  --teal-dk: #8B5A63;
  --teal-lt: #F5EBF0;
  --gold:    #D4AF37;
  --gold-lt: #F5E8C0;
  --brown:   #3E2723;
  --brown-lt:#E8DFD7;
  --peach:   #F2B89A;
  --peach-lt:#FDF3EE;
  --turq:    #C9A877;
  --cream:   #FDF8F2;
  --dark:    #1C1C1C;
  --mid:     #4A4A4A;
  --light:   #888;
  --font-serif: 'Cormorant Garamond', serif;
  --font-sans:  'Jost', sans-serif;
  --nav-h: 70px;
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

html { scroll-behavior: smooth; }

body {
  font-family: var(--font-sans);
  background: var(--cream);
  color: var(--dark);
  overflow-x: hidden;
}

/* ─── SCROLLBAR ─────────────────────────────────────────────────────────── */
::-webkit-scrollbar { width: 5px; }
::-webkit-scrollbar-track { background: var(--cream); }
::-webkit-scrollbar-thumb { background: var(--gold); border-radius: 10px; }

/* ─── NAV ────────────────────────────────────────────────────────────────── */
nav {
  position: fixed; top: 0; left: 0; right: 0; z-index: 1000;
  height: var(--nav-h);
  display: flex; align-items: center; justify-content: space-between;
  padding: 0 40px;
  transition: background .4s, box-shadow .4s;
}
nav.scrolled {
  background: rgba(253,248,242,.97);
  box-shadow: 0 2px 20px rgba(184,118,127,.12);
  backdrop-filter: blur(8px);
}
.nav-brand {
  font-family: var(--font-serif);
  font-size: 1.3rem;
  color: var(--teal);
  letter-spacing: .04em;
  text-decoration: none;
}
.nav-links { display: flex; gap: 32px; list-style: none; }
.nav-links a {
  font-family: var(--font-sans);
  font-size: .78rem;
  font-weight: 500;
  letter-spacing: .12em;
  text-transform: uppercase;
  color: var(--dark);
  text-decoration: none;
  transition: color .2s;
  position: relative;
}
.nav-links a::after {
  content:''; position:absolute; bottom:-3px; left:0; right:0; height:1px;
  background:var(--gold); transform:scaleX(0); transition:transform .25s;
}
.nav-links a:hover { color: var(--teal); }
.nav-links a:hover::after { transform:scaleX(1); }
.hamburger {
  display:none; flex-direction:column; gap:5px; cursor:pointer; background:none; border:none; padding:4px;
}
.hamburger span { display:block; width:24px; height:2px; background:var(--dark); transition:.3s; }
.hamburger.open span:nth-child(1) { transform:rotate(45deg) translate(5px,5px); }
.hamburger.open span:nth-child(2) { opacity:0; }
.hamburger.open span:nth-child(3) { transform:rotate(-45deg) translate(5px,-5px); }
.mobile-menu {
  display:none; position:fixed; inset:0; top:var(--nav-h);
  background:rgba(253,248,242,.98); backdrop-filter:blur(12px);
  flex-direction:column; align-items:center; justify-content:center; gap:36px;
  z-index:999;
}
.mobile-menu.open { display:flex; }
.mobile-menu a {
  font-family:var(--font-serif); font-size:2rem; color:var(--dark);
  text-decoration:none; letter-spacing:.05em;
}
.mobile-menu a:hover { color:var(--teal); }

/* ─── HERO ───────────────────────────────────────────────────────────────── */
#hero {
  min-height: 100vh;
  position: relative;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  text-align: center;
  overflow: hidden;
  padding: 80px 20px 40px;
}
.hero-bg {
  position: absolute; inset: 0;
  background:
    linear-gradient(160deg, rgba(253,248,242,.85) 0%, rgba(245,235,240,.55) 40%, rgba(253,243,238,.55) 70%, rgba(253,248,242,.85) 100%),
    radial-gradient(ellipse at 20% 80%, rgba(184,118,127,.15) 0%, transparent 55%),
    radial-gradient(ellipse at 80% 20%, rgba(212,175,55,.12) 0%, transparent 50%),
    radial-gradient(ellipse at 50% 50%, rgba(242,184,154,.1) 0%, transparent 60%),
    url('images/IMG_5515.JPG');
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  pointer-events: none;
}
.hero-floral {
  position:absolute; pointer-events:none;
}
.hero-floral.tl { top:-40px; left:-40px; width:380px; opacity:.18; }
.hero-floral.br { bottom:-40px; right:-40px; width:380px; opacity:.18; transform:rotate(180deg); }
.hero-content { position:relative; z-index:2; }
.hero-tag {
  display:inline-block;
  font-family:var(--font-sans); font-size:.72rem; font-weight:600;
  letter-spacing:.2em; text-transform:uppercase; color:var(--turq);
  border:1px solid var(--turq); padding:6px 18px; border-radius:20px;
  margin-bottom:28px;
  animation: fadeUp .9s .1s both;
}
.hero-names {
  font-family:var(--font-serif);
  font-size: clamp(3.5rem, 10vw, 7.5rem);
  font-weight:300; line-height:1.05;
  color:var(--teal-dk);
  animation: fadeUp .9s .2s both;
}
.hero-names em { font-style:italic; color:var(--brown); }
.hero-amp {
  display:block; font-size:.5em; color:var(--gold); margin:.1em 0;
}
.hero-date {
  margin-top: 24px;
  font-family:var(--font-sans); font-size:.9rem; font-weight:300;
  letter-spacing:.25em; text-transform:uppercase; color:var(--mid);
  animation: fadeUp .9s .35s both;
}
.hero-hashtag {
  margin-top:10px;
  font-family:var(--font-serif); font-style:italic; font-size:1.4rem;
  color:var(--gold);
  animation: fadeUp .9s .45s both;
}
.divider-flourish {
  margin: 28px auto;
  width:120px; height:2px;
  background: linear-gradient(90deg, transparent, var(--gold), transparent);
  animation: fadeUp .9s .5s both;
}

/* Countdown */
.countdown {
  display:flex; gap:24px; justify-content:center; flex-wrap:wrap;
  animation: fadeUp .9s .6s both;
}
.countdown-unit {
  display:flex; flex-direction:column; align-items:center;
  background:rgba(255,255,255,.7); border:1px solid rgba(212,175,55,.2);
  border-radius:12px; padding:16px 22px; min-width:80px;
  backdrop-filter:blur(6px);
}
.countdown-num {
  font-family:var(--font-serif); font-size:2.6rem; font-weight:600;
  color:var(--teal); line-height:1;
}
.countdown-label {
  font-size:.62rem; font-weight:600; letter-spacing:.15em;
  text-transform:uppercase; color:var(--light); margin-top:4px;
}
.scroll-hint {
  position:absolute; bottom:30px; left:50%; transform:translateX(-50%);
  display:flex; flex-direction:column; align-items:center; gap:6px;
  color:var(--light); font-size:.7rem; letter-spacing:.15em; text-transform:uppercase;
  animation: bounce 2s infinite;
}
.scroll-hint svg { width:18px; height:18px; stroke:var(--gold); }

/* ─── SECTIONS ───────────────────────────────────────────────────────────── */
section { padding: 100px 24px; }
.section-inner { max-width: 1100px; margin: 0 auto; }
.section-label {
  font-family:var(--font-sans); font-size:.7rem; font-weight:600;
  letter-spacing:.22em; text-transform:uppercase; color:var(--turq);
  margin-bottom:12px;
}
.section-title {
  font-family:var(--font-serif); font-size: clamp(2rem,5vw,3.2rem);
  font-weight:300; color:var(--teal-dk); line-height:1.2;
  margin-bottom: 20px;
}
.section-title em { font-style:italic; color:var(--brown); }
.section-sub {
  font-size:.95rem; color:var(--mid); line-height:1.8; max-width:560px;
}

/* ─── STORY ──────────────────────────────────────────────────────────────── */
#story { background: var(--brown-lt); }
.timeline {
  margin-top: 60px;
  display:grid; grid-template-columns: repeat(auto-fit, minmax(240px,1fr));
  gap:32px;
}
.timeline-card {
  background:#fff; border-radius:16px;
  padding:36px 28px;
  border-top:3px solid var(--gold);
  box-shadow:0 4px 24px rgba(62,39,35,.08);
  transition: transform .3s, box-shadow .3s;
  opacity:0; transform:translateY(30px);
  transition: opacity .6s, transform .6s, box-shadow .3s;
}
.timeline-card.visible { opacity:1; transform:translateY(0); }
.timeline-card:hover { transform:translateY(-6px); box-shadow:0 12px 40px rgba(62,39,35,.14); }
.timeline-icon { font-size:2.2rem; margin-bottom:16px; }
.timeline-date {
  font-size:.72rem; font-weight:600; letter-spacing:.18em;
  text-transform:uppercase; color:var(--turq); margin-bottom:10px;
}
.timeline-title {
  font-family:var(--font-serif); font-size:1.5rem; font-weight:600;
  color:var(--teal-dk); margin-bottom:12px;
}
.timeline-text { font-size:.88rem; color:var(--mid); line-height:1.8; }
.timeline-subcard {
  padding: 20px 0 0;
  border-top: 1px solid rgba(184,118,127,.12);
  margin-top: 20px;
}
.timeline-subcard:first-child { margin-top: 0; border-top: none; padding-top: 0; }
.timeline-subtitle {
  font-family: var(--font-sans); font-size: .9rem; font-weight: 700;
  letter-spacing: .08em; text-transform: uppercase;
  color: var(--teal-dk); margin-bottom: 14px;
}

/* ─── EVENTS ─────────────────────────────────────────────────────────────── */
#events { background: var(--cream); }
.event-cards {
  margin-top:60px;
  display:grid; grid-template-columns:repeat(auto-fit,minmax(300px,1fr));
  gap:32px;
}
.event-card {
  border-radius:20px; overflow:hidden;
  box-shadow:0 6px 30px rgba(184,118,127,.1);
  opacity:0; transform:translateY(30px);
  transition:opacity .6s, transform .6s;
}
.event-card.visible { opacity:1; transform:translateY(0); }
.event-card-header {
  padding:36px 32px 28px;
  position:relative;
}
.event-card:nth-child(1) .event-card-header {
  background: linear-gradient(135deg, var(--teal), var(--teal-dk));
}
.event-card:nth-child(2) .event-card-header {
  background: linear-gradient(135deg, var(--brown), #2C1F1B);
}
.event-type {
  font-size:.68rem; font-weight:600; letter-spacing:.2em;
  text-transform:uppercase; color:rgba(255,255,255,.7); margin-bottom:10px;
}
.event-name {
  font-family:var(--font-serif); font-size:2.2rem; font-weight:300;
  color:#fff; line-height:1.1;
}
.event-card-body { background:#fff; padding:28px 32px; }
.event-detail {
  display:flex; align-items:flex-start; gap:12px;
  padding:12px 0; border-bottom:1px solid rgba(0,0,0,.06);
}
.event-detail:last-of-type { border-bottom:none; }
.event-detail-icon { font-size:1rem; margin-top:2px; flex-shrink:0; }
.event-detail-text { font-size:.88rem; color:var(--mid); line-height:1.6; }
.event-detail-text strong { color:var(--dark); display:block; }
.btn-cal {
  display:inline-block; margin-top:20px;
  padding:11px 28px;
  background:transparent; border:1.5px solid var(--gold);
  color:var(--gold); font-family:var(--font-sans); font-size:.78rem;
  font-weight:600; letter-spacing:.12em; text-transform:uppercase;
  border-radius:30px; cursor:pointer; text-decoration:none;
  transition:background .2s, color .2s;
}
.btn-cal:hover { background:var(--gold); color:#fff; }
.cal-actions { display:flex; gap:10px; flex-wrap:wrap; margin-top:20px; }
.cal-actions .btn-cal { margin-top:0; }
.btn-cal-google { border-color:var(--teal-dk); color:var(--teal-dk); }
.btn-cal-google:hover { background:var(--teal-dk); color:#fff; }

/* ─── RSVP ────────────────────────────────────────────────────────────────── */
#rsvp {
  background: linear-gradient(160deg, #6B505A 0%, #4A3640 100%);
  position:relative; overflow:hidden;
}
#rsvp::before {
  content:''; position:absolute; top:-100px; right:-100px;
  width:500px; height:500px; border-radius:50%;
  background:rgba(184,118,127,.08);
}
#rsvp .section-label { color:var(--peach); }
#rsvp .section-title { color:#fff; }
#rsvp .section-title em { color:var(--gold); }
#rsvp .section-sub { color:rgba(255,255,255,.65); }
.rsvp-form {
  margin-top:48px;
  background:rgba(255,255,255,.06);
  border:1px solid rgba(255,255,255,.12);
  border-radius:24px; padding:48px;
  backdrop-filter:blur(10px);
  max-width:700px; margin-left:auto; margin-right:auto;
}
.form-row { display:grid; grid-template-columns:1fr 1fr; gap:20px; }
.form-group { display:flex; flex-direction:column; gap:8px; margin-bottom:20px; }
.form-group label {
  font-size:.72rem; font-weight:600; letter-spacing:.15em;
  text-transform:uppercase; color:rgba(255,255,255,.65);
}
.form-group input, .form-group select, .form-group textarea {
  background:rgba(255,255,255,.1);
  border:1px solid rgba(255,255,255,.2); border-radius:10px;
  padding:13px 18px; color:#fff; font-family:var(--font-sans); font-size:.9rem;
  outline:none; transition:border .2s, background .2s;
}
.form-group input::placeholder,
.form-group textarea::placeholder { color:rgba(255,255,255,.3); }
.form-group select option { background:var(--teal-dk); }
.form-group input:focus,
.form-group select:focus,
.form-group textarea:focus {
  border-color:var(--gold); background:rgba(255,255,255,.15);
}
.form-group textarea { resize:vertical; min-height:90px; }
.form-error { font-size:.75rem; color:var(--peach); margin-top:2px; display:none; }
.form-group.has-error input,
.form-group.has-error textarea { border-color:var(--peach); }
.form-group.has-error .form-error { display:block; }

.checkbox-group { display:flex; flex-wrap:wrap; gap:12px; margin-top:4px; }
.checkbox-label {
  display:flex; align-items:center; gap:8px;
  cursor:pointer; font-size:.88rem; color:rgba(255,255,255,.8);
}
.checkbox-label input[type=checkbox] {
  width:18px; height:18px; accent-color:var(--gold);
  border:none; padding:0; background:transparent;
}
.btn-rsvp {
  width:100%; padding:16px;
  background:linear-gradient(135deg, var(--gold), #B8860B);
  border:none; border-radius:12px; cursor:pointer;
  font-family:var(--font-sans); font-size:.9rem; font-weight:600;
  letter-spacing:.1em; text-transform:uppercase; color:#fff;
  margin-top:10px; transition:opacity .2s, transform .2s;
}
.btn-rsvp:hover { opacity:.9; transform:translateY(-1px); }
.rsvp-already {
  text-align:center; padding:48px;
  font-family:var(--font-serif); font-size:1.6rem; color:var(--gold);
}

/* ─── GIFTS ──────────────────────────────────────────────────────────────── */
#gifts { background:var(--peach-lt); }
.gift-intro {
  font-family:var(--font-serif); font-style:italic;
  font-size:1.15rem; color:var(--brown); max-width:600px; line-height:1.8;
  margin-top:8px;
}
.registry-link {
  margin: 18px 0 24px;
}
.registry-link a {
  display:inline-flex; align-items:center; gap:8px;
  padding:12px 18px; border-radius:999px;
  background:linear-gradient(135deg, var(--teal), var(--gold));
  color:#fff; font-weight:600; text-decoration:none;
  box-shadow:0 12px 24px rgba(184,118,127,.16);
  transition:transform .2s ease, box-shadow .2s ease;
}
.registry-link a:hover {
  transform:translateY(-2px);
  box-shadow:0 14px 28px rgba(184,118,127,.22);
}
.gift-cards {
  margin-top:52px;
  display:grid; grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
  gap:28px;
}
.gift-card {
  background:#fff; border-radius:20px; padding:36px 30px;
  border:2px solid transparent;
  box-shadow:0 4px 24px rgba(62,39,35,.07);
  transition:border .3s, transform .3s, box-shadow .3s;
  opacity:0; transform:translateY(30px);
  transition:opacity .6s, transform .6s, border .3s, box-shadow .3s;
}
.gift-card.visible { opacity:1; transform:translateY(0); }
.gift-card:hover { border-color:var(--gold); transform:translateY(-5px); box-shadow:0 16px 40px rgba(62,39,35,.14); }
.gift-card-icon { font-size:2.4rem; margin-bottom:18px; }
.gift-card-title { font-family:var(--font-serif); font-size:1.55rem; color:var(--teal-dk); margin-bottom:10px; }
.gift-card-text { font-size:.85rem; color:var(--mid); line-height:1.8; margin-bottom:22px; }
.gift-account {
  background:var(--teal-lt); border-radius:10px; padding:14px 16px;
  font-size:.82rem; color:var(--teal-dk); line-height:1.9; margin-bottom:16px;
}
.btn-copy {
  display:inline-flex; align-items:center; gap:8px;
  padding:10px 22px; border-radius:30px;
  background:var(--teal); color:#fff; border:none;
  font-size:.78rem; font-weight:600; letter-spacing:.1em; text-transform:uppercase;
  cursor:pointer; transition:background .2s;
}
.btn-copy:hover { background:var(--teal-dk); }
.btn-copy.copied { background:var(--gold); }
.wishlist-grid {
  display:grid; grid-template-columns:repeat(2,1fr); gap:12px; margin-top:10px;
}
.wishlist-item {
  background:var(--cream); border-radius:12px; padding:14px 12px;
  text-align:center; cursor:pointer; transition:background .2s;
  border:1px solid rgba(212,175,55,.15);
}
.wishlist-item:hover { background:var(--gold-lt); }
.wishlist-item-icon { font-size:1.4rem; margin-bottom:5px; }
.wishlist-item-name { font-size:.78rem; font-weight:600; color:var(--dark); }
.wishlist-item-price { font-size:.72rem; color:var(--light); }
.btn-contribute {
  display:block; width:100%; margin-top:14px;
  padding:10px; background:transparent;
  border:1.5px solid var(--brown); border-radius:30px;
  font-family:var(--font-sans); font-size:.78rem; font-weight:600;
  letter-spacing:.1em; text-transform:uppercase; color:var(--brown);
  cursor:pointer; transition:background .2s, color .2s;
}
.btn-contribute:hover { background:var(--brown); color:#fff; }

/* ===== REGISTRY ===== */
.reg-summary{display:flex;gap:16px;justify-content:center;margin:34px 0 24px;flex-wrap:wrap}
.reg-stat{background:#fff;border-radius:14px;padding:16px 30px;text-align:center;
  box-shadow:0 4px 20px rgba(123,79,46,.08);border-top:3px solid var(--gold)}
.reg-stat .n{font-family:var(--font-serif);font-size:1.9rem;font-weight:600;color:var(--teal)}
.reg-stat .l{font-size:.68rem;letter-spacing:.12em;text-transform:uppercase;color:var(--light);margin-top:2px}

.reg-account{max-width:640px;margin:0 auto 36px;background:var(--teal-lt);border-radius:12px;
  padding:18px 20px;font-size:.9rem;color:var(--teal-dk)}
.reg-account-title{font-family:var(--font-serif);font-size:1.2rem;color:var(--teal-dk);margin-bottom:10px}
.reg-detail-list{display:flex;flex-direction:column;gap:10px;margin-top:8px}
.reg-detail-row{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:10px 12px;
  border-radius:12px;background:rgba(255,255,255,.7);border:1px solid rgba(123,79,46,.08)}
.reg-detail-label{font-size:.72rem;letter-spacing:.1em;text-transform:uppercase;color:var(--teal-dk);font-weight:600}
.reg-detail-value{flex:1;color:var(--mid);word-break:break-word}
.reg-detail-copy{background:var(--teal);color:#fff;border:none;border-radius:999px;width:34px;height:34px;
  cursor:pointer;flex-shrink:0;font-size:.95rem}
.reg-detail-copy.copied{background:var(--gold)}

.reg-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(290px,1fr));gap:24px}
.reg-loading{grid-column:1/-1;text-align:center;color:var(--light);padding:40px;font-style:italic}
.reg-card{background:#fff;border-radius:18px;overflow:hidden;border:2px solid transparent;
  box-shadow:0 4px 24px rgba(123,79,46,.09);transition:.3s;display:flex;flex-direction:column}
.reg-card:hover{border-color:var(--gold);transform:translateY(-4px)}
.reg-thumb{height:130px;background:linear-gradient(135deg,var(--teal-lt),var(--gold-lt));
  display:flex;align-items:center;justify-content:center;font-size:2.8rem;position:relative}
.reg-tag{position:absolute;top:12px;right:12px;font-size:.6rem;font-weight:600;letter-spacing:.1em;
  text-transform:uppercase;padding:5px 12px;border-radius:20px;background:rgba(255,255,255,.9);color:var(--brown)}
.reg-card.done .reg-thumb::after{content:'BLESSED ✓';position:absolute;inset:0;
  background:rgba(26,122,110,.82);color:#fff;display:flex;align-items:center;justify-content:center;
  font-family:var(--font-serif);font-size:1.5rem;letter-spacing:.08em}
.reg-body{padding:20px;display:flex;flex-direction:column;flex:1}
.reg-name{font-family:var(--font-serif);font-size:1.35rem;font-weight:600;color:var(--teal-dk)}
.reg-desc{font-size:.8rem;color:var(--mid);line-height:1.6;margin:6px 0 14px;flex:1}
.reg-price{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:8px}
.reg-price .goal{font-size:.72rem;color:var(--light)}
.reg-price .amt{font-family:var(--font-serif);font-size:1.4rem;font-weight:600;color:var(--brown)}
.reg-bar{height:8px;background:var(--brown-lt);border-radius:10px;overflow:hidden;margin-bottom:6px}
.reg-fill{height:100%;background:linear-gradient(90deg,var(--gold),var(--teal));border-radius:10px;transition:width .6s}
.reg-prog{display:flex;justify-content:space-between;font-size:.72rem;color:var(--mid);margin-bottom:16px}
.reg-prog b{color:var(--teal);font-weight:600}
.reg-btn{padding:12px;border:none;border-radius:10px;background:linear-gradient(135deg,var(--gold),#A37A09);
  color:#fff;font-weight:600;font-size:.8rem;letter-spacing:.08em;text-transform:uppercase;cursor:pointer;transition:.2s}
.reg-btn:hover{opacity:.9}
.reg-btn.done{background:var(--teal-lt);color:var(--teal);cursor:default}

/* modal extras */
.reg-modal{max-width:440px;text-align:left}
.reg-modal .modal-title,.reg-modal .modal-icon{text-align:center;width:100%}
.reg-remaining{text-align:center;color:var(--mid);font-size:.9rem;margin-bottom:18px}
.reg-field{margin-bottom:14px}
.reg-field label{display:block;font-size:.72rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--mid);margin-bottom:6px}
.reg-field input{width:100%;padding:12px 16px;border:1px solid #ddd;border-radius:10px;font-family:var(--font-sans);font-size:.95rem;outline:none}
.reg-field input:focus{border-color:var(--gold)}
.reg-acctbox{background:var(--teal-lt);border-radius:12px;padding:16px;font-size:.85rem;color:var(--teal-dk);line-height:1.8;margin:16px 0 10px}
.reg-acctno{display:flex;align-items:center;gap:10px;font-weight:600;font-size:1rem}
.reg-acctno button{margin-left:auto}
.reg-ref{font-size:.78rem;color:var(--brown)}
.reg-steps{text-align:center;font-size:.78rem;color:var(--light);margin:10px 0 16px}
.reg-privacy{text-align:center;font-size:.72rem;color:var(--light);margin-top:14px;line-height:1.5}

/* ─── GALLERY ────────────────────────────────────────────────────────────── */
#gallery { background:var(--cream); }
.gallery-grid {
  margin-top:52px;
  position: relative;
  width: 100%;
  height: 520px;
  overflow: hidden;
  border-radius: 24px;
}
.gallery-slide {
  position: absolute;
  inset: 0;
  opacity: 0;
  transition: opacity .8s ease;
  cursor: pointer;
  background-size: cover;
  background-position: center center;
  background-repeat: no-repeat;
  pointer-events: none;
  z-index: 0;
}
.gallery-slide.active { opacity: 1; pointer-events: auto; z-index: 2; }
.gallery-dots {
  position: absolute;
  bottom: 18px;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  gap: 10px;
  z-index: 2;
}
.gallery-dot {
  width: 12px;
  height: 12px;
  border-radius: 50%;
  background: rgba(255,255,255,.55);
  border: 1px solid rgba(184,118,127,.45);
  cursor: pointer;
  transition: transform .2s, background .2s;
}
.gallery-dot.active {
  background: var(--teal);
  transform: scale(1.1);
}

/* ─── TRAVEL ─────────────────────────────────────────────────────────────── */
#travel { background:var(--teal-lt); }
.travel-grid {
  margin-top:52px;
  display:grid; grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
  gap:28px;
}
.travel-card {
  background:#fff; border-radius:16px; padding:30px 26px;
  box-shadow:0 4px 20px rgba(184,118,127,.08);
  opacity:0; transform:translateY(20px);
  transition:opacity .6s, transform .6s;
}
.travel-card.visible { opacity:1; transform:translateY(0); }
.travel-card-icon { font-size:1.8rem; margin-bottom:14px; }
.travel-card-title { font-family:var(--font-serif); font-size:1.35rem; color:var(--teal-dk); margin-bottom:12px; }
.travel-card-text { font-size:.85rem; color:var(--mid); line-height:1.8; }
.travel-card-sub { font-size:.8rem; color:var(--light); margin-top:6px; }
.btn-book {
  display:inline-block; margin-top:16px;
  padding:9px 22px; border-radius:30px;
  border:1.5px solid var(--teal); color:var(--teal);
  font-family:var(--font-sans); font-size:.78rem; font-weight:600;
  letter-spacing:.1em; text-transform:uppercase;
  text-decoration:none; cursor:pointer; background:transparent;
  transition:background .2s, color .2s;
}
.btn-book:hover { background:var(--teal); color:#fff; }
.map-wrap {
  margin-top:40px; border-radius:18px; overflow:hidden;
  height:280px; background:var(--brown-lt);
  display:flex; align-items:center; justify-content:center;
  border:2px dashed rgba(62,39,35,.3);
}
.map-placeholder { text-align:center; color:var(--light); font-size:.85rem; }
.map-placeholder p { margin-top:10px; }

/* ─── FAQ ─────────────────────────────────────────────────────────────────── */
#faq { background:var(--cream); }
.faq-list { margin-top:48px; max-width:740px; }
.faq-item {
  border-bottom:1px solid rgba(0,0,0,.08);
  opacity:0; transform:translateX(-20px);
  transition:opacity .5s, transform .5s;
}
.faq-item.visible { opacity:1; transform:translateX(0); }
.faq-q {
  display:flex; align-items:center; justify-content:space-between;
  padding:22px 0; cursor:pointer;
  font-family:var(--font-serif); font-size:1.15rem; color:var(--dark);
  gap:20px;
}
.faq-q:hover { color:var(--teal); }
.faq-icon {
  width:28px; height:28px; flex-shrink:0;
  border-radius:50%; border:1.5px solid var(--gold);
  display:flex; align-items:center; justify-content:center;
  font-size:.9rem; color:var(--gold); transition:transform .3s, background .3s;
}
.faq-item.open .faq-icon { transform:rotate(45deg); background:var(--gold); color:#fff; }
.faq-a {
  max-height:0; overflow:hidden; transition:max-height .4s ease;
  font-size:.9rem; color:var(--mid); line-height:1.8;
}
.faq-a-inner { padding-bottom:22px; }
.faq-item.open .faq-a { max-height:200px; }

/* ─── FOOTER ─────────────────────────────────────────────────────────────── */
footer {
  background:var(--teal-dk); color:rgba(255,255,255,.7);
  padding:60px 24px 40px; text-align:center;
}
.footer-names {
  font-family:var(--font-serif); font-size:2.5rem; font-weight:300;
  color:#fff; margin-bottom:8px;
}
.footer-hash {
  font-family:var(--font-serif); font-style:italic;
  font-size:1.1rem; color:var(--gold); margin-bottom:24px;
}
.footer-qr { display:flex; flex-direction:column; align-items:center; gap:12px; margin-bottom:36px; }
.footer-qr-title { font-family:var(--font-serif); font-size:1.15rem; color:#fff; }
.footer-qr-code {
  display:inline-block; width:150px; height:150px; padding:12px;
  background:#fff; border-radius:14px; border:1px solid rgba(255,255,255,.2);
  transition:border-color .2s, transform .2s;
}
.footer-qr-code:hover { border-color:var(--gold); transform:translateY(-2px); }
.footer-qr-code svg { width:100%; height:100%; display:block; }
.footer-qr-text { font-size:.8rem; color:rgba(255,255,255,.6); max-width:280px; line-height:1.5; }
.footer-copy { font-size:.75rem; color:rgba(255,255,255,.35); letter-spacing:.08em; }
.footer-divider {
  margin: 0 auto 32px;
  width:200px; height:1px;
  background:linear-gradient(90deg,transparent,rgba(212,175,55,.6),transparent);
}

/* ─── MODALS ─────────────────────────────────────────────────────────────── */
.modal-overlay {
  position:fixed; inset:0; z-index:2000;
  background:rgba(0,0,0,.6); backdrop-filter:blur(4px);
  display:none; align-items:center; justify-content:center; padding:20px;
}
.modal-overlay.open { display:flex; }
.modal {
  background:#fff; border-radius:24px;
  padding:48px 40px; max-width:480px; width:100%;
  text-align:center; position:relative;
  animation:modalPop .4s cubic-bezier(.34,1.56,.64,1) both;
}
@keyframes modalPop { from{opacity:0;transform:scale(.8)} to{opacity:1;transform:scale(1)} }
.modal-close {
  position:absolute; top:16px; right:18px;
  background:none; border:none; font-size:1.4rem;
  color:var(--light); cursor:pointer;
}
.modal-icon { font-size:3rem; margin-bottom:16px; }
.modal-title {
  font-family:var(--font-serif); font-size:1.8rem; color:var(--teal-dk);
  margin-bottom:10px;
}
.modal-text { font-size:.9rem; color:var(--mid); line-height:1.8; }
.modal-hash { font-family:var(--font-serif); font-style:italic; color:var(--gold); font-size:1.2rem; margin-top:16px; }
.hearts {
  display:flex; justify-content:center; gap:8px; margin-top:20px; font-size:1.4rem;
}
.heart { animation:heartBeat 1.2s infinite; }
.heart:nth-child(2) { animation-delay:.2s; }
.heart:nth-child(3) { animation-delay:.4s; }
@keyframes heartBeat { 0%,100%{transform:scale(1)} 50%{transform:scale(1.3)} }

/* ─── RSVP BADGE ─────────────────────────────────────────────────────────── */
.rsvp-badge {
  position:fixed; bottom:24px; right:24px; z-index:900;
  background:var(--teal); color:#fff; border-radius:30px;
  padding:10px 18px; font-size:.75rem; font-weight:600;
  letter-spacing:.08em; box-shadow:0 4px 20px rgba(184,118,127,.3);
  cursor:pointer; display:none;
}

/* ─── ANIMATIONS ─────────────────────────────────────────────────────────── */
@keyframes fadeUp { from{opacity:0;transform:translateY(24px)} to{opacity:1;transform:translateY(0)} }
@keyframes bounce { 0%,100%{transform:translateX(-50%) translateY(0)} 50%{transform:translateX(-50%) translateY(-8px)} }

/* ─── RESPONSIVE ─────────────────────────────────────────────────────────── */
@media(max-width:768px) {
  .nav-links { display:none; }
  .hamburger { display:flex; }
  nav { padding:0 20px; }
  .form-row { grid-template-columns:1fr; }
  .rsvp-form { padding:28px 20px; }
  .gallery-grid {
    grid-template-columns:1fr 1fr;
    grid-template-rows:auto;
  }
  .gallery-slot:nth-child(1) { grid-row:span 1; }
  .gallery-slot:nth-child(5) { grid-column:span 1; }
  .event-cards { grid-template-columns:1fr; }
  section { padding:70px 18px; }
  .modal { padding:32px 24px; }
  .wishlist-grid { grid-template-columns:1fr 1fr; }
}
</style>
</head>
<body>

