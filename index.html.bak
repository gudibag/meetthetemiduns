<!-- ── RSVP ────────────────────────────────────────────────────────────────── -->
<section id="rsvp">
  <div class="section-inner">
    <div class="section-label">You're invited</div>
    <h2 class="section-title">RSVP <em>Here</em></h2>
    <p class="section-sub">Please let us know you're coming. RSVPs close one month before the big day.</p>
    <div id="rsvpWrapper">
      <form class="rsvp-form" id="rsvpForm" novalidate>
        <div class="form-row">
          <div class="form-group" id="fg-firstname">
            <label>First Name *</label>
            <input type="text" id="rsvp-firstname" placeholder="First name">
            <span class="form-error">Please enter your first name</span>
          </div>
          <div class="form-group" id="fg-lastname">
            <label>Last Name *</label>
            <input type="text" id="rsvp-lastname" placeholder="Last name">
            <span class="form-error">Please enter your last name</span>
          </div>
        </div>
        <div class="form-row">
          <div class="form-group" id="fg-email">
            <label>Email Address (optional)</label>
            <input type="email" id="rsvp-email" placeholder="you@example.com">
            <span class="form-error">Please enter a valid email if provided</span>
          </div>
          <div class="form-group">
            <label>Phone Number</label>
            <input type="tel" id="rsvp-phone" placeholder="+234 ...">
          </div>
        </div>
        <div class="form-group">
          <label>Message to the Couple</label>
          <textarea id="rsvp-msg" placeholder="Share a note, congratulations, or anything you'd like us to know."></textarea>
        </div>
        <button type="submit" class="btn-rsvp">Confirm My Attendance ✨</button>
      </form>
    </div>
  </div>
</section>

